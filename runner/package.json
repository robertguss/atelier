{
  "name": "@atelier/runner",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local --watch src/index.ts",
    "start": "node --env-file-if-exists=.env.local src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test src/review.test.ts src/turns.test.ts src/rotate-secret.test.ts src/adapters/*.test.ts",
    "rotate-secret": "node src/rotate-secret.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.318",
    "@atelier/backend": "workspace:*",
    "@atelier/shared": "workspace:*",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "convex": "^1.49.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2"
  }
}
