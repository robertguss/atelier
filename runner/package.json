{
  "name": "@atelier/runner",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local --watch src/index.ts",
    "start": "node --env-file-if-exists=.env.local src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "rotate-secret": "node src/rotate-secret.ts",
    "coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.318",
    "@atelier/backend": "workspace:*",
    "@atelier/shared": "workspace:*",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "convex": "^1.49.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.1.0",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
